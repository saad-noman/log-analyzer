# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment and secrets
.env
.env.*
!.env.example

# Build output
frontend/dist/
backend/dist/

# Logs and temporary files
*.log
npm-debug.log*
.DS_Store

# User data and generated output (keep directory placeholders)
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep

# Downloaded model weights can be large; keep only the directory placeholder
models/downloaded-model/*
!models/downloaded-model/.gitkeep

# Local llama.cpp runtime binaries and server output (downloaded, not source)
runtime/
